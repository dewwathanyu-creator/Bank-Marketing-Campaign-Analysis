table _Measures
	lineageTag: edda8aee-8615-4892-b650-36df39e8af96

	measure Customers = COUNTROWS ( bank_clean )
		formatString: #,0
		lineageTag: 749ea8a6-e164-4e75-a337-e4edc190416e

	measure Subscribers = CALCULATE ( COUNTROWS ( bank_clean ), bank_clean[y_flag] = 1 )
		formatString: #,0
		lineageTag: 18ff878e-700c-4ae4-8011-fd547405cd7f

	measure 'Yes Rate' = DIVIDE ( [Subscribers], [Customers] )
		formatString: 0.0%
		lineageTag: 676dea1f-5dae-47a0-a745-e5e18f8ffdd3

	measure 'Calls Made' = SUM ( bank_clean[campaign] )
		formatString: #,0
		lineageTag: fb3b6326-c646-471c-9805-7e66b09ebb26

	measure 'Contacts per Client' = DIVIDE ( [Calls Made], [Customers] )
		formatString: 0.0
		lineageTag: 29f15220-78d0-4942-91e3-226f30ada864

	measure 'Calls per Subscriber' = DIVIDE ( [Calls Made], [Subscribers] )
		formatString: 0.0
		lineageTag: 6d1d0901-7525-41f7-9497-5f0958904db4

	measure 'Yield per Call' = DIVIDE ( [Subscribers], [Calls Made] )
		formatString: 0.0%
		lineageTag: b7fbbc30-1ed2-4c8b-809b-c374c08811bf

	measure 'Calls in Band' =
			VAR b = SELECTEDVALUE ( CallBand[Band] )
			RETURN
			    SWITCH ( b,
			        "Calls 1-3", SUMX ( bank_clean, MIN ( bank_clean[campaign], 3 ) ),
			        "Calls 4+",  SUMX ( bank_clean, MAX ( bank_clean[campaign] - 3, 0 ) ) )
		formatString: #,0
		lineageTag: a9471cda-91e0-4b3b-b432-58d6f01ec4f9

	measure 'Subscribers in Band' =
			VAR b = SELECTEDVALUE ( CallBand[Band] )
			RETURN
			    SWITCH ( b,
			        "Calls 1-3", CALCULATE ( [Subscribers], bank_clean[campaign] <= 3 ),
			        "Calls 4+",  CALCULATE ( [Subscribers], bank_clean[campaign] >= 4 ) )
		formatString: #,0
		lineageTag: 4c1e044a-58e3-4400-be52-6e107f3f4e88

	measure 'Yield by Band' = DIVIDE ( [Subscribers in Band], [Calls in Band] )
		formatString: 0.0%
		lineageTag: 95901f94-b710-40d4-8a18-72b247c6050e

	measure 'Calls at Number' =
			VAR k = SELECTEDVALUE ( CallNumber[CallNo] )
			RETURN
			    IF ( ISBLANK ( k ), BLANK (),
			        IF ( k < 7,
			            CALCULATE ( COUNTROWS ( bank_clean ), bank_clean[campaign] >= k ),
			            SUMX ( FILTER ( bank_clean, bank_clean[campaign] > 6 ), bank_clean[campaign] - 6 ) ) )
		formatString: #,0
		lineageTag: cd6e9c2f-9ffa-4ff4-8d58-9d4eebb1404a

	measure 'Subscribers at Number' =
			VAR k = SELECTEDVALUE ( CallNumber[CallNo] )
			RETURN
			    IF ( ISBLANK ( k ), BLANK (),
			        IF ( k < 7,
			            CALCULATE ( [Subscribers], bank_clean[campaign] = k ),
			            CALCULATE ( [Subscribers], bank_clean[campaign] > 6 ) ) )
		formatString: #,0
		lineageTag: 779a9149-b0cc-47bd-9e03-855243042acd

	measure 'Yield at Number' = DIVIDE ( [Subscribers at Number], [Calls at Number] )
		formatString: 0.0%
		lineageTag: d19b4d24-4b0f-47ce-8f5f-b7af5743c4f2

	measure 'Yes Rate vs All' =
			DIVIDE ( [Yes Rate],
			    CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order], bank_clean[poutcome] ) ) )
		formatString: 0.00
		lineageTag: 4cd81d59-6844-41fc-a0d1-40e7b6ce1e57

	measure 'Yes Rate Never Contacted' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[poutcome] ), bank_clean[poutcome] = "nonexistent" )
		formatString: 0.0%
		lineageTag: 1ea1b572-fd7e-414f-9bdc-a24c1d627a3f

	measure 'Ratio vs Never Contacted' = DIVIDE ( [Yes Rate], [Yes Rate Never Contacted] )
		formatString: 0.00
		lineageTag: 6b61fa46-ca88-4dfc-b038-52e59ee81023

	measure 'Customers Label' = IF ( [Customers] < 500, FORMAT ( [Customers], "#,0" ) & " (small group)", FORMAT ( [Customers], "#,0" ) )
		lineageTag: 6732fbb8-50e8-487d-8c6b-410347412224

	measure 'Yes Rate (min 100)' = IF ( [Customers] >= 100, [Yes Rate] )
		formatString: 0.0%
		lineageTag: 74df2c14-8426-4cf4-93b9-863cb27ad68b

	measure 'Yes Rate Large' = IF ( [Customers] >= 500, [Yes Rate] )
		formatString: 0.0%
		lineageTag: 627abf61-4ae8-4135-8f93-b88073ffc9e6

	measure 'Yes Rate Small' = IF ( [Customers] >= 100 && [Customers] < 500, [Yes Rate] )
		formatString: 0.0%
		lineageTag: a0cdf105-7093-4e50-8e1c-8329dfb252c0

	measure 'Both Channels 100' =
			VAR nCell = CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[contact] ), bank_clean[contact] = "cellular" )
			VAR nTele = CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[contact] ), bank_clean[contact] = "telephone" )
			RETURN IF ( nCell >= 100 && nTele >= 100, 1, 0 )
		formatString: 0
		lineageTag: 88f38bb0-0c6b-4c84-abff-16a02269d3cf

	measure 'Share of Year Customers' = DIVIDE ( [Customers], CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[campaign_band], bank_clean[Campaign Band Order] ) ) )
		formatString: 0.0%
		lineageTag: 78d12717-1cac-4cbc-a75c-aa00d22e3787

	measure 'Yes Rate Both Channels' = IF ( [Both Channels 100] = 1, [Yes Rate] )
		formatString: 0.0%
		lineageTag: 03d20fb2-bf01-4705-988a-911f5cfe566e

	measure 'Yes Rate 2009 (min 100)' = CALCULATE ( IF ( [Customers] >= 100, [Yes Rate] ), bank_clean[year] = "2009" )
		formatString: 0.0%
		lineageTag: 37740ea8-4bab-4148-b449-bb8d6a657778

	measure 'Narr Dot' = " " & UNICHAR ( 183 ) & " "
		isHidden
		displayFolder: Narrative
		lineageTag: 7c0af766-7453-47da-b285-e4d7304a9171

	measure 'Narr Arrow' = " " & UNICHAR ( 8594 ) & " "
		isHidden
		displayFolder: Narrative
		lineageTag: 05845a7d-7796-4e5d-8288-1e3205ef1097

	measure 'Narr Yes 2008' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2008" )
		isHidden
		displayFolder: Narrative
		lineageTag: 791e92e0-4679-42d7-bf83-59ae3d82a610

	measure 'Narr Yes 2009' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2009" )
		isHidden
		displayFolder: Narrative
		lineageTag: 9e54cbba-9fd9-44a1-b55d-f1d3213d45f1

	measure 'Narr Yes 2010' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2010" )
		isHidden
		displayFolder: Narrative
		lineageTag: abae2832-8f85-482d-9684-c4c020dcc700

	measure 'Narr Yes All Years' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 4c08e617-7389-4b3b-b626-733c11667cb7

	measure 'Narr CPS 2008' = CALCULATE ( [Calls per Subscriber], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2008" )
		isHidden
		displayFolder: Narrative
		lineageTag: 9a368670-7cee-45e8-999d-b682b26ce046

	measure 'Narr CPS 2010' = CALCULATE ( [Calls per Subscriber], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2010" )
		isHidden
		displayFolder: Narrative
		lineageTag: 3116cc05-af64-4022-80ea-db09415a54a9

	measure 'Narr Scope' =
			VAR yrs = IF ( ISFILTERED ( bank_clean[year] ), "Year " & CONCATENATEX ( VALUES ( bank_clean[year] ), bank_clean[year], ", ", bank_clean[year], ASC ), "All years" )
			VAR ch = IF ( ISFILTERED ( bank_clean[contact] ), CONCATENATEX ( VALUES ( bank_clean[contact] ), bank_clean[contact], ", ", bank_clean[contact], ASC ), "all channels" )
			RETURN yrs & ", " & ch & ", " & FORMAT ( [Customers], "#,0" ) & " clients"
		isHidden
		displayFolder: Narrative
		lineageTag: 8289eaa1-5c53-46fb-ab3b-de98ac675a1b

	measure 'Narr Calls4 Share' = DIVIDE ( SUMX ( bank_clean, MAX ( bank_clean[campaign] - 3, 0 ) ), [Calls Made] )
		isHidden
		displayFolder: Narrative
		lineageTag: 71aa03d1-e628-4178-ac2d-4a579e896285

	measure 'Narr Subs4 Share' = DIVIDE ( CALCULATE ( [Subscribers], bank_clean[campaign] >= 4 ), [Subscribers] )
		isHidden
		displayFolder: Narrative
		lineageTag: 7b0b3399-8f53-47a3-a3f3-bc2cbc8c3b63

	measure 'Narr Subs By Call3' = DIVIDE ( CALCULATE ( [Subscribers], bank_clean[campaign] <= 3 ), [Subscribers] )
		isHidden
		displayFolder: Narrative
		lineageTag: f9ec23b8-12a4-4b8f-81b6-e7bead6bc481

	measure 'Narr Share Le3' = DIVIDE ( CALCULATE ( [Customers], bank_clean[campaign] <= 3 ), [Customers] )
		isHidden
		displayFolder: Narrative
		lineageTag: a298a594-7364-4fac-bba4-c3fbdb455cbf

	measure 'Narr Ratio Success 2009' = DIVIDE ( CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[poutcome] = "success" ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[poutcome] = "nonexistent" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: ff9557b2-4697-4fe5-8927-7ecfb2f59071

	measure 'Narr Ratio Success 2010' = DIVIDE ( CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2010", bank_clean[poutcome] = "success" ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2010", bank_clean[poutcome] = "nonexistent" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 992c8a69-92d0-438b-b703-8a845b7ac50f

	measure 'Narr Ratio Failure 2008' = DIVIDE ( CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2008", bank_clean[poutcome] = "failure" ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2008", bank_clean[poutcome] = "nonexistent" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 35784c6e-4d1e-4b0a-b0c7-2a09210720fa

	measure 'Narr Ratio Failure 2009' = DIVIDE ( CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[poutcome] = "failure" ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[poutcome] = "nonexistent" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: ec445fb9-b2c6-4f36-827a-e1f9afebd97a

	measure 'Narr Ratio Failure 2010' = DIVIDE ( CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2010", bank_clean[poutcome] = "failure" ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2010", bank_clean[poutcome] = "nonexistent" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 2a2ed3b4-c3f2-427b-a40c-15a32fd4046d

	measure 'Narr Success 2008 Clients' = CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[year], bank_clean[poutcome], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2008", bank_clean[poutcome] = "success" )
		isHidden
		displayFolder: Narrative
		lineageTag: f40e82c5-354f-4c06-bb85-3c61aab426a3

	measure 'Narr Age 2008 Min' = MINX ( VALUES ( bank_clean[age_band] ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2008" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 176d75f4-2aad-4895-a86c-51903e17503d

	measure 'Narr Age 2008 Max' = MAXX ( VALUES ( bank_clean[age_band] ), CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year] ), bank_clean[year] = "2008" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 0ebdd43a-63de-4557-98f8-3101d387ae5a

	measure 'Narr Age 60+ 2009' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[age_band] = "60+" )
		isHidden
		displayFolder: Narrative
		lineageTag: 240b610e-0e63-489e-9289-459e83425150

	measure 'Narr Job retired 2009' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[job] ), bank_clean[year] = "2009", bank_clean[job] = "retired" )
		isHidden
		displayFolder: Narrative
		lineageTag: 493eb39e-5557-427f-b65e-9a15a9f033b3

	measure 'Narr Job student 2009' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[job] ), bank_clean[year] = "2009", bank_clean[job] = "student" )
		isHidden
		displayFolder: Narrative
		lineageTag: 0d83dfac-ccab-4f6d-93ed-0cd3c0d35e10

	measure 'Narr Job blue-collar 2009' = CALCULATE ( [Yes Rate], REMOVEFILTERS ( bank_clean[year], bank_clean[job] ), bank_clean[year] = "2009", bank_clean[job] = "blue-collar" )
		isHidden
		displayFolder: Narrative
		lineageTag: b3c4546e-c978-4378-a53d-45d64886bc59

	measure 'Narr Retired 60+ 2009' = CALCULATE ( [Yes Rate (min 100)], REMOVEFILTERS ( bank_clean[year], bank_clean[job], bank_clean[age_band], bank_clean[Age Band Order] ), bank_clean[year] = "2009", bank_clean[job] = "retired", bank_clean[age_band] = "60+" )
		isHidden
		displayFolder: Narrative
		lineageTag: 5a0c5a69-c42e-443c-aeee-69f8894954b9

	measure 'Narr Euribor 2008 Share' = DIVIDE ( CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[year], bank_clean[euribor_band], bank_clean[Euribor Band Order] ), bank_clean[year] = "2008", bank_clean[euribor_band] = "2+" ), CALCULATE ( [Customers], REMOVEFILTERS ( bank_clean[year], bank_clean[euribor_band], bank_clean[Euribor Band Order] ), bank_clean[euribor_band] = "2+" ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 356d184c-f916-4d60-9c50-1812c9d74fd0

	measure 'Narr Yield Cell 2008' = CALCULATE ( [Yield per Call], REMOVEFILTERS ( bank_clean[year], bank_clean[contact] ), bank_clean[year] = "2008", bank_clean[contact] = "cellular" )
		isHidden
		displayFolder: Narrative
		lineageTag: 6e46dad6-f65c-4fe1-bbbb-1ee05bfaa033

	measure 'Narr Yield Cell 2010' = CALCULATE ( [Yield per Call], REMOVEFILTERS ( bank_clean[year], bank_clean[contact] ), bank_clean[year] = "2010", bank_clean[contact] = "cellular" )
		isHidden
		displayFolder: Narrative
		lineageTag: d69bcb1a-a90c-4988-9afc-85f95bc05344

	measure 'Narr Yield Tele 2008' = CALCULATE ( [Yield per Call], REMOVEFILTERS ( bank_clean[year], bank_clean[contact] ), bank_clean[year] = "2008", bank_clean[contact] = "telephone" )
		isHidden
		displayFolder: Narrative
		lineageTag: ed7e8f8f-29ff-4794-a80c-fd9c360135d6

	measure 'Narr Yield Tele 2010' = CALCULATE ( [Yield per Call], REMOVEFILTERS ( bank_clean[year], bank_clean[contact] ), bank_clean[year] = "2010", bank_clean[contact] = "telephone" )
		isHidden
		displayFolder: Narrative
		lineageTag: 212cb1ac-5c9d-49d7-90f1-0e2f9561a308

	measure 'Narr Gain 20' = LOOKUPVALUE ( model_gains[model_share_of_subscribers_pct], model_gains[share_of_customers_called_pct], 20 )
		isHidden
		displayFolder: Narrative
		lineageTag: 5b403081-0fa8-46c6-8830-96893cfb832f

	measure 'Narr Gain 50' = LOOKUPVALUE ( model_gains[model_share_of_subscribers_pct], model_gains[share_of_customers_called_pct], 50 )
		isHidden
		displayFolder: Narrative
		lineageTag: 95a7650b-526e-4f74-905f-131ed57a2176

	measure 'Narr Channel Table' =
			VAR t =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( bank_clean[campaign_period] ),
			            "@c", CALCULATE ( [Customers], bank_clean[contact] = "cellular" ),
			            "@t", CALCULATE ( [Customers], bank_clean[contact] = "telephone" ),
			            "@yc", CALCULATE ( [Yes Rate], bank_clean[contact] = "cellular" ),
			            "@yt", CALCULATE ( [Yes Rate], bank_clean[contact] = "telephone" )
			        ),
			        [@c] >= 100 && [@t] >= 100
			    )
			RETURN COALESCE ( COUNTROWS ( t ), 0 ) & "|" & COALESCE ( COUNTROWS ( FILTER ( t, [@yc] > [@yt] ) ), 0 )
		isHidden
		displayFolder: Narrative
		lineageTag: 3d039339-b262-4171-80f5-0c1f62cf01ad

	measure 'Narr Channel Months' = VALUE ( LEFT ( [Narr Channel Table], FIND ( "|", [Narr Channel Table] ) - 1 ) )
		isHidden
		displayFolder: Narrative
		lineageTag: df8f8621-3bee-4c55-86d9-5a127f8de42a

	measure 'Narr Channel Wins' = VALUE ( MID ( [Narr Channel Table], FIND ( "|", [Narr Channel Table] ) + 1, 5 ) )
		isHidden
		displayFolder: Narrative
		lineageTag: 38c5550f-7df7-4ad2-9c2b-6f87a6eeec59

	measure 'Narr T1 Page' = "The pooled " & FORMAT ( [Narr Yes All Years], "0.0%" ) & " yes rate hides a rise from " & FORMAT ( [Narr Yes 2008], "0.0%" ) & " in 2008 to " & FORMAT ( [Narr Yes 2010], "0.0%" ) & " in 2010"
		displayFolder: Narrative
		lineageTag: 3114584c-0a91-4319-98bf-a54203e5dfe1

	measure 'Narr T1 Sub' = [Narr Scope] & ". Yes rate is subscribers divided by clients."
		displayFolder: Narrative
		lineageTag: 424836c3-86ff-4e6f-8cfd-54e2fe482e7b

	measure 'Narr T1 Period' = IF ( ISFILTERED ( bank_clean[year] ), "Yes rate by campaign month in " & [Narr Years Text], IF ( [Narr Yes 2008] < [Narr Yes 2009] && [Narr Yes 2009] < [Narr Yes 2010], "Yes rate rises every campaign year, from " & FORMAT ( [Narr Yes 2008], "0.0%" ) & " in 2008 to " & FORMAT ( [Narr Yes 2009], "0.0%" ) & " in 2009 and " & FORMAT ( [Narr Yes 2010], "0.0%" ) & " in 2010", "Yes rate by campaign period" ) )
		displayFolder: Narrative
		lineageTag: bda671ef-121f-4ac8-8a0d-419646234b42

	measure 'Narr T1 Channel' = IF ( [Narr Channel Months] > 0, "Cellular converts better in " & [Narr Channel Wins] & " of " & [Narr Channel Months] & " months that have at least 100 clients on both channels", "Channel comparison inside the same month" )
		displayFolder: Narrative
		lineageTag: a58c0dd4-4c7b-485a-959f-d6f3f4edd24f

	measure 'Narr T1 Band' = "Calls 4 and later are " & FORMAT ( [Narr Calls4 Share], "0.0%" ) & " of calls but only " & FORMAT ( [Narr Subs4 Share], "0.0%" ) & " of subscriptions"
		displayFolder: Narrative
		lineageTag: 55ab0c61-ca6b-4d61-8ff9-c393a2d3c47b

	measure 'Narr T1 CallNo' = FORMAT ( [Narr Subs By Call3], "0.0%" ) & " of subscriptions arrive by the third call"
		displayFolder: Narrative
		lineageTag: 005a07e5-c2b5-42a1-9415-2a0395cafd37

	measure 'Narr T1 Foot' = "Yield assumes a subscriber is not called again. Months under 100 clients are left out of the line, months with 100 to 499 clients are marked with dots, and months missing from the file are not shown. Years are inferred from file order. There is no cost data, so any cost figure is an assumption."
		displayFolder: Narrative
		lineageTag: ba38869e-4bed-4c6a-8280-742fea8d38d2

	measure 'Narr T2 Page' = IF ( ISBLANK ( [Narr Ratio Success 2009] ), "Who responds depends on the campaign year", "Clients with a previous success convert " & FORMAT ( [Narr Ratio Success 2009], "0.0" ) & " times as often in 2009 and " & FORMAT ( [Narr Ratio Success 2010], "0.0" ) & " times as often in 2010 as never-contacted clients" )
		displayFolder: Narrative
		lineageTag: 2978a739-3081-40cd-9769-97fa5d85048b

	measure 'Narr T2 Sub' = [Narr Scope] & ". Each year is read on its own."
		displayFolder: Narrative
		lineageTag: 66b32234-8e07-48bc-903e-dec1fe1d144b

	measure 'Narr T2 Age' = IF ( ISFILTERED ( bank_clean[year] ), "Yes rate by age band in " & [Narr Years Text], "In 2008 every age band converts between " & FORMAT ( [Narr Age 2008 Min], "0.0%" ) & " and " & FORMAT ( [Narr Age 2008 Max], "0.0%" ) & ", and gaps open from 2009, when clients aged 60 and over reach " & FORMAT ( [Narr Age 60+ 2009], "0.0%" ) )
		displayFolder: Narrative
		lineageTag: 899f5d0f-8b9c-4773-b8a9-1c64e80a8846

	measure 'Narr Fail Min' = MIN ( MIN ( [Narr Ratio Failure 2008], [Narr Ratio Failure 2009] ), [Narr Ratio Failure 2010] )
		isHidden
		displayFolder: Narrative
		lineageTag: 88e8c14d-ff6c-45dc-b2ac-dc11be83ff7e

	measure 'Narr Fail Max' = MAX ( MAX ( [Narr Ratio Failure 2008], [Narr Ratio Failure 2009] ), [Narr Ratio Failure 2010] )
		isHidden
		displayFolder: Narrative
		lineageTag: a228f9ff-e007-48fd-96b9-512369bf14bb

	measure 'Narr T2 Outcome' = IF ( ISFILTERED ( bank_clean[year] ), "Yes rate by previous campaign outcome in " & [Narr Years Text], IF ( [Narr Fail Max] < 1, "In every year previous failure converts at only " & FORMAT ( [Narr Fail Min], "0.00" ) & " to " & FORMAT ( [Narr Fail Max], "0.00" ) & " times the rate of never-contacted clients", "Previous campaign outcome" ) )
		displayFolder: Narrative
		lineageTag: 91058a2d-9a21-4547-8fd1-48e1b1fcd424

	measure 'Narr T2 Job' = IF ( ISFILTERED ( bank_clean[year] ), "Yes rate by job in " & [Narr Years Text], "Job gaps open from 2009, with retired clients at " & FORMAT ( [Narr Job retired 2009], "0.0%" ) & " and students at " & FORMAT ( [Narr Job student 2009], "0.0%" ) & " against " & FORMAT ( [Narr Job blue-collar 2009], "0.0%" ) & " for blue-collar" )
		displayFolder: Narrative
		lineageTag: adf4e8ea-5110-4988-9adf-4aaad087d0b5

	measure 'Narr T2 JobAge' = IF ( ISBLANK ( [Narr Retired 60+ 2009] ), "Job and age together, 2009 only", "In 2009 retired clients aged 60 and over convert at " & FORMAT ( [Narr Retired 60+ 2009], "0.0%" ) & ", while groups under 100 clients are left blank" )
		displayFolder: Narrative
		lineageTag: dbe75cc7-cc4f-44f8-8d3f-5e1e89bc3b17

	measure 'Narr T2 Foot' = "Groups under 100 clients are blank. Compare inside one year only. In 2008 previous success has " & FORMAT ( [Narr Success 2008 Clients], "#,0" ) & " clients, so no conclusion is drawn."
		displayFolder: Narrative
		lineageTag: 24dee37c-f621-4d1f-b58c-f2e178adfce1

	measure 'Narr T3 Page' = "Call previous-success clients first and pilot a retry cap, because calls 4 and later take " & FORMAT ( [Narr Calls4 Share], "0.0%" ) & " of calls but bring only " & FORMAT ( [Narr Subs4 Share], "0.0%" ) & " of subscriptions"
		displayFolder: Narrative
		lineageTag: 3fb0291d-6abc-4fd7-bf8d-d4e6cfd6eb46

	measure 'Narr T3 Sub' = [Narr Scope] & ". Lift is a fixed test on 2009 and 2010."
		displayFolder: Narrative
		lineageTag: 1075a999-d77f-4d91-8d38-2a6f03a18f01

	measure 'Narr T3 Euribor' = IF ( [Narr Euribor 2008 Share] >= 0.995, "The whole band at 2% and above is 2008 clients, so Euribor and year cannot be separated", "Yes rate by Euribor 3m band, read inside one year" )
		displayFolder: Narrative
		lineageTag: e1876d51-525c-4a33-b585-11b02de623c4

	measure 'Narr T3 CPS' = IF ( ISFILTERED ( bank_clean[year] ), "Calls per subscriber in " & [Narr Years Text] & ": " & FORMAT ( [Calls per Subscriber], "0.0" ), IF ( ISBLANK ( [Narr CPS 2008] ) || ISBLANK ( [Narr CPS 2010] ), "Calls per subscriber, by year", "Calls per subscriber fell from " & FORMAT ( [Narr CPS 2008], "0.0" ) & " in 2008 to " & FORMAT ( [Narr CPS 2010], "0.0" ) & " in 2010" ) )
		displayFolder: Narrative
		lineageTag: 41e99f6f-de09-41d8-a3c3-6957c716306a

	measure 'Narr T3 Yield' = IF ( ISFILTERED ( bank_clean[year] ), "Yield per call in " & [Narr Years Text] & ": " & FORMAT ( [Yield per Call], "0.0%" ), "From 2008 to 2010 yield per call went from " & FORMAT ( [Narr Yield Cell 2008], "0.0%" ) & " to " & FORMAT ( [Narr Yield Cell 2010], "0.0%" ) & " for cellular and from " & FORMAT ( [Narr Yield Tele 2008], "0.0%" ) & " to " & FORMAT ( [Narr Yield Tele 2010], "0.0%" ) & " for telephone" )
		displayFolder: Narrative
		lineageTag: d5b05d85-5f2c-4d40-a59d-790fee3dc290

	measure 'Narr T3 Share' = FORMAT ( [Narr Share Le3], "0.0%" ) & " of clients get three calls or fewer"
		displayFolder: Narrative
		lineageTag: 8864c5f0-2860-4da8-903f-a98d3f8d384a

	measure 'Narr T3 Gains' = IF ( ISBLANK ( [Narr Gain 20] ), "Model ranking against random calling", "Calling the top 20% by model score reaches " & FORMAT ( [Narr Gain 20], "0.0" ) & "% of subscribers, against 20% at random" )
		displayFolder: Narrative
		lineageTag: 30003e69-e3f9-4151-8c4c-6185e602079d

	measure 'Narr T3 Table' = IF ( ISBLANK ( [Narr Gain 50] ), "Share of subscribers reached", "The top 50% of the list reaches " & FORMAT ( [Narr Gain 50], "0.0" ) & "% of subscribers, against 50% at random" )
		displayFolder: Narrative
		lineageTag: 9302f9d5-0d7c-4605-8fa5-647156c425e4

	measure 'Narr T3 Foot' = "Euribor is read within one year only. Lift is a fixed test result for 2009 and 2010, with an AUC of 0.693. Call duration is not used."
		displayFolder: Narrative
		lineageTag: 3393b660-a8e9-4de8-8a76-8916515c0c4d

	measure 'Narr Side Label' = "STORY IN THREE STEPS"
		displayFolder: Narrative
		lineageTag: 0fa82d1d-8d21-443c-abab-e451f39dca95

	measure 'Narr Side Note' = "RESEARCH, NOT A COST MODEL"
		displayFolder: Narrative
		lineageTag: 8f611c81-c96c-4446-a2dc-9a197cdf90d7

	measure 'Narr Side Src' = "UCI bank-additional-full"
		displayFolder: Narrative
		lineageTag: d4b4f6ad-e492-413d-95a8-ca7ae0dc2402

	measure 'Narr Side Count' = "Showing " & FORMAT ( [Customers], "#,0" ) & " clients"
		displayFolder: Narrative
		lineageTag: e9648c64-a3ff-4091-a2f4-084032e07b5f

	measure 'Narr Years Text' = CONCATENATEX ( VALUES ( bank_clean[year] ), bank_clean[year], " and ", bank_clean[year], ASC )
		isHidden
		displayFolder: Narrative
		lineageTag: 99ba335c-6bad-4287-a011-7274e25d569a

	column x
		lineageTag: 129c02b4-741e-4605-a9f7-2c4928e1bb2c
		isNameInferred
		sourceColumn: [x]

	partition _Measures = calculated
		mode: import
		source = ROW ( "x", 1 )

