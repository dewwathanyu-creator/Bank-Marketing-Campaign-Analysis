model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: th-TH
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["DataFolder","bank_clean","model_gains"]

ref table bank_clean
ref table CallBand
ref table CallNumber
ref table model_gains
ref table _Measures

ref cultureInfo en-US

